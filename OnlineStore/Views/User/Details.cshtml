@model User


<div class="d-flex justify-content-center mb-4">
    <h2 class="text-success fw-bold display-4">User Details</h2>
</div>
<div class="d-flex justify-content-center">
    <div class="card" style="width: 35rem;">
        <div class="card-body">
            <h4 class="card-title text-center"><span class="fw-bold">@Model.FirstName @Model.LastName </span>Details</h4>
            <div class="text-muted">
                <h5 class="card-subtitle mb-2">@Html.DisplayNameFor(u => u.UserId): <span class="fw-bold">@Model.UserId</span></h5>
                <h5 class="card-subtitle mb-2">@Html.DisplayNameFor(u => u.FirstName): <span class="fw-bold">@Model.FirstName</span></h5>
                <h5 class="card-subtitle mb-2">@Html.DisplayNameFor(u => u.LastName): <span class="fw-bold">@Model.LastName</span></h5>
                <h5 class="card-subtitle mb-2 text-muted">@Html.DisplayNameFor(u => u.Email): <span class="fw-bold">@Model.Email</span></h5>
            </div>
            <a asp-controller="User" asp-action="Index" class="btn btn-outline-secondary custom-btn" title="Return">
                <img src="~/Styles/return icon.svg" alt="Not Found" class="icon" />
            </a>
        </div>
    </div>
</div>

