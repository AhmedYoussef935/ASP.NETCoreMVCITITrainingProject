
@model User

<div class="d-flex justify-content-center mb-4" >
    <h2 class="text-success display-4 fw-bold">User Log In</h2>
</div>

<div class="d-flex justify-content-center">
    <div class="card p-4 sign-card">
        <h4 class="card-title text-center text-success fw-bold">Log In Your Account</h4>
        <div class="d-flex fw-bold lead">
            <p class="text">Don't have an account?&nbsp;</p>
            <a asp-controller="User" asp-action="Create" class="link">Sign Up</a>
        </div>
        <form asp-controller="User" asp-action="Login" method="post">
            <div class="form-group">
                <label asp-for="Email" class="form-label fw-bold fs-5"></label>
                <input asp-for="Email" class="form-control">
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <label asp-for="Password" class="form-label fw-bold fs-5"></label>
                <input asp-for="Password" class="form-control">
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="d-flex justify-content-center mt-3 gap-5">
                <input type="submit" value="Log In" class="btn btn-success" title="Log In">
            </div>
        </form>
    </div>
</div>

