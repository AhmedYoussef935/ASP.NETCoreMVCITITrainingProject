<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OnlineStore</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OnlineStore.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-success"  asp-area="" asp-controller="Home" asp-action="Index">OnlineStore</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @{
                            string currectController = ViewContext.RouteData.Values["Controller"].ToString();
                            string currectAction = ViewContext.RouteData.Values["Action"].ToString();
                        }
                        @* @if (!(currectController == "User" && (currectAction == "Login" || currectAction == "Create")) && !(currectController == "Home" && currectAction == "Privacy" && OnlineStore.Controllers.HomeController.Name == "Guest")) *@
                        <li class="nav-item">
                            <a class="nav-link text-dark custom-btn" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark custom-btn" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        @if (OnlineStore.Controllers.HomeController.Name == "Guest")
                        {
                            <li class="nav-item ms-auto">
                                <a class="nav-link text-dark custom-btn" asp-area="" asp-controller="User" asp-action="Login">
                                    <img src="~/Styles/login.png" class="link-icon" alt="Not Found" />
                                    Log In/Sign Up
                                </a>
                            </li>
                        }
                        else
                        {
                            
                            <li class="nav-item">
                                <a class="nav-link text-dark custom-btn" asp-area="" asp-controller="User" asp-action="Index">Users</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark custom-btn" asp-area="" asp-controller="Product" asp-action="Index">Products</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark custom-btn" asp-area="" asp-controller="Category" asp-action="Index">Categories</a>
                            </li>
                            <li class="nav-item ms-auto">
                                <a class="nav-link text-dark custom-btn" asp-area="" asp-controller="User" asp-action="Logout">
                                    <img src="~/Styles/sign-out.png" class="icon" style="width:1.3em; height:1.3em; vertical-align: middle; " alt="Not Found" />
                                    Log Out
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - OnlineStore - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            - ITI ASP.NET MVC Project - Created By <span class="fw-bold">Ahmed Youssef</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
