@model Category

<div class="d-flex justify-content-center mb-4">
    <h2 class="text-success display-4 fw-bold">New Brand</h2>
</div>

<form asp-controller="Category" asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="CategoryName" class="form-label fs-5 fw-bold"></label>
        <input asp-for="CategoryName" class="form-control">
        <span asp-validation-for="CategoryName" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="CategoryDescription" class="form-label fs-5 fw-bold"></label>
        <input asp-for="CategoryDescription" class="form-control">
        <span asp-validation-for="CategoryDescription" class="text-danger"></span>
    </div>
    <div class="d-flex justify-content-center mt-3 gap-4">
        <input type="submit" value="Add" class="btn btn-success" title="Add Category">
        <a asp-Controller="Category" asp-action="Index" class="btn btn-secondary" title="Cancel">Cancel</a>
    </div>
</form>


