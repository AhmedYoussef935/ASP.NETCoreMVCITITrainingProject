@model Category

<div class="d-flex justify-content-center mb-4">
    <h2 class="text-success display-4 fw-bold">Edit Brand</h2>
</div>

<h3 class="text-muted display-6">Edit <span class="fw-bold">@Model.CategoryName </span> Info</h3>

<form asp-controller="Category" asp-action="Edit" method="post">
    <input asp-for="CategoryId" class="form-control" value="@Model.CategoryId" hidden>
    <div class="form-group">
        <label asp-for="CategoryName" class="form-label fs-5 fw-bold"></label>
        <input asp-for="CategoryName" class="form-control" value="@Model.CategoryName">
        <span asp-validation-for="CategoryName" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="CategoryDescription" class="form-label fs-5 fw-bold"></label>
        <input asp-for="CategoryDescription" class="form-control" value="@Model.CategoryDescription">
        <span asp-validation-for="CategoryDescription" class="text-danger"></span>
    </div>
    <div class="d-flex justify-content-center mt-3 gap-4">
        <input type="submit" value="Edit" class="btn btn-success" title="Edit">
        <a asp-Controller="Category" asp-action="Index" class="btn btn-secondary" title="Cancel">Cancel</a>
    </div>
</form>



