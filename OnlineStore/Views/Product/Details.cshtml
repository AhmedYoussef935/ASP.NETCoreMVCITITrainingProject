@model Product

<div class="d-flex justify-content-center mb-4">
    <h2 class="text-success fw-bold display-4">Product Details</h2>
</div>
<div class="d-flex justify-content-center">
    <div class="card" style="width: 35rem;">
        <div class="card-body">
            <h4 class="card-title mb-2 text-center"><span class="fw-bold">@Model.Title </span>Details</h4>
            <figure class="text-center">
                <img src="@Url.Content(Model.ImagePath)" alt="Not Found" class="imageV02" />
                <figcaption class="text-muted fw-bold">@Model.Title Figure</figcaption>
            </figure>
            <hr />
            <div class="text-muted">
                <h5 class="card-subtitle mb-2">@Html.DisplayNameFor(p => p.ProductId): <span class="fw-bold">@Model.ProductId</span></h5>
                <h5 class="card-subtitle mb-2">@Html.DisplayNameFor(p => p.Title): <span class="fw-bold">@Model.Title</span></h5>
                <h5 class="card-subtitle mb-2">@Html.DisplayNameFor(p => p.Description): <span class="fw-bold">@Model.Description</span></h5>
                <h5 class="card-subtitle mb-2">@Html.DisplayNameFor(p => p.Price): <span class="fw-bold">@Model.Price $</span></h5>
                <h5 class="card-subtitle mb-2">@Html.DisplayNameFor(p => p.Quantity): <span class="fw-bold">@Model.Quantity</span></h5>
            </div>
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary custom-btn" title="Return">
                <img src="~/Styles/return icon.svg" alt="Not Found" class="icon" />
            </a>
        </div>
    </div>
</div>
