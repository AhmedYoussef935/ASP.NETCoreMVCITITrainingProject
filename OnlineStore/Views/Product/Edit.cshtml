@model Product

<div class="d-flex justify-content-center mb-4">
    <h2 class="text-success display-4 fw-bold">Edit Product</h2>
</div>

<h3 class="text-secondary display-6">Edit <span class="fw-bold">@Model.Title</span> Info</h3>
<form asp-controller="Product" asp-action="Edit" method="post" class="fs-5">
    <input asp-for="ProductId" value="@Model.ProductId" hidden>
    <div class="form-group">
        <label asp-for="Title" class="form-label fw-bold"></label>
        <input asp-for="Title" class="form-control" value="@Model.Title">
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="Description" class="form-label fw-bold"></label>
        <input asp-for="Description" class="form-control" value="@Model.Description">
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="Price" class="form-label fw-bold"></label>
        <input asp-for="Price" class="form-control" value="@Model.Price">
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="Quantity" class="form-label fw-bold"></label>
        <input asp-for="Quantity" class="form-control" value="@Model.Quantity">
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="ImagePath" class="form-label fw-bold"></label>
        <input asp-for="ImagePath" class="form-control" value="@Model.ImagePath">
        <span asp-validation-for="ImagePath" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="CategoryId" class="form-label fw-bold"></label>
        <select asp-for="CategoryId"class="form-select">
            @foreach(var item in ViewBag.Categories)
            {
                if (int.Parse(item.Value) == Model.CategoryId)
                {
                    <option value="@item.Value" selected>@item.Text</option>
                }
                else
                {
                    <option value="@item.Value">@item.Text</option>
                }
            }
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>
    <div class="d-flex justify-content-center mt-3 gap-4">
        <input type="submit" value="Edit" class="btn btn-success" title="Apply Edits To This Product">
        <a asp-Controller="Product" asp-action="Index" class="btn btn-secondary" title="Cancel">Cancel</a>
    </div>
</form>


