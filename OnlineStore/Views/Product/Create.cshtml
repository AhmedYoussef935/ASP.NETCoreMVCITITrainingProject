@model Product

<div class="d-flex justify-content-center mb-4">
    <h2 class="text-success display-4 fw-bold">New Product</h2>
</div>

<form asp-controller="Product" asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="Title" class="form-label fw-bold fs-5"></label>
        <input asp-for="Title" class="form-control">
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="Description" class="form-label fw-bold fs-5"></label>
        <input asp-for="Description" class="form-control">
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="Price" class="form-label fw-bold fs-5"></label>
        <input asp-for="Price" class="form-control">
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="Quantity" class="form-label fw-bold fs-5"></label>
        <input asp-for="Quantity" class="form-control">
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="ImagePath" class="form-label fw-bold fs-5"></label>
        <input asp-for="ImagePath" class="form-control">
        <span asp-validation-for="ImagePath" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="CategoryId" class="form-label fw-bold fs-5"></label>
        <select asp-for="CategoryId" asp-items="@ViewBag.Categories" class="form-select">
            <option value="">--Select Brand--</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>
    <div class="d-flex justify-content-center mt-3 gap-4">
        <input type="submit" value="Add" class="btn btn-success" title="Add">
        <a asp-Controller="Product" asp-action="Index" class="btn btn-secondary" title="Cancel">Cancel</a>
    </div>
</form>

