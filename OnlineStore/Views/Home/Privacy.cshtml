@{
    ViewData["Title"] = "Privacy Policy";
}
<h2 class="text-success text-center display-4 fw-bold mb-4">@ViewData["Title"]</h2>
<section class="lead text-muted">
    <p>
        We at our online store value your privacy and are committed to protecting your personal data.
        By using our website, you agree to the following terms:
    </p>
    <ol>
        <li>
            Information We Collect
            <ul>
                <li>
                    We may collect information such as your name, email address
                    and shipping details when you place an order or create an account.
                </li>
                <li>
                    We may also use cookies to improve your browsing experience.
                </li>
            </ul>
        </li>
        <li>
            How We Use Your Information
            <ul>
                <li>To process and deliver your orders.</li>
                <li>To communicate with you about your purchases, offers, or customer support inquiries.</li>
                <li>We will never sell or share your personal data with third parties, except when required by law.</li>
            </ul>
        </li>
        <li>
            How We Use Your Information
            <ul>
                <li>
                    You have the right to request access to, update, or delete your personal information at any time by contacting us.
                </li>
            </ul>
        </li>
    </ol>
</section>

